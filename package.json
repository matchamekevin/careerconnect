{
  "name": "careerconnect-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "Plateforme de recrutement CareerConnect - Frontend avec Supabase",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=frontend",
